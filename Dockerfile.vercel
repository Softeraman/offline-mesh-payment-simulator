FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY pom.xml .
RUN mvn -B dependency:go-offline
COPY src ./src
RUN mvn -B package
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
COPY --from=build /build/target/upi-offline-mesh-0.0.1-SNAPSHOT.jar app.jar
ENV PORT=80
EXPOSE 80
CMD ["java", "-XX:MaxRAMPercentage=70", "-jar", "app.jar"]
